{
	"version": 3,
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"title": "Arunika Malam",
	"description": "Varian gelap bernuansa arang dengan teks pasir, zaitun lembut, dan aksen terakota.",
	"settings": {
		"color": {
			"duotone": [
				{
					"colors": [ "#1f1e1b", "#ece4d6" ],
					"name": "Arang dan Pasir",
					"slug": "black-and-white"
				},
				{
					"colors": [ "#1f1e1b", "#a3ae88" ],
					"name": "Arang dan Zaitun",
					"slug": "primary-and-white"
				},
				{
					"colors": [ "#1f1e1b", "#d27a52" ],
					"name": "Arang dan Terakota",
					"slug": "secondary-and-white"
				}
			],
			"palette": [
				{
					"color": "#1f1e1b",
					"name": "Arang Malam (Base)",
					"slug": "base"
				},
				{
					"color": "#ece4d6",
					"name": "Pasir (Contrast)",
					"slug": "contrast"
				},
				{
					"color": "#a3ae88",
					"name": "Zaitun Muda (Primary)",
					"slug": "primary"
				},
				{
					"color": "#c9d1b4",
					"name": "Zaitun Pucat (Secondary)",
					"slug": "secondary"
				},
				{
					"color": "#d27a52",
					"name": "Terakota (Accent)",
					"slug": "accent"
				},
				{
					"color": "#4a463f",
					"name": "Batu Gelap (Stone)",
					"slug": "stone"
				},
				{
					"color": "#2a2824",
					"name": "Arang Hangat (Neutral)",
					"slug": "neutral"
				}
			]
		},
		"shadow": {
			"presets": [
				{
					"name": "Light",
					"shadow": "0 20px 50px rgba(0, 0, 0, 0.45)",
					"slug": "light"
				},
				{
					"name": "Solid",
					"shadow": "6px 6px 0 rgba(210, 122, 82, 1)",
					"slug": "solid"
				}
			]
		}
	},
	"styles": {
		"elements": {
			"button": {
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			}
		}
	}
}
